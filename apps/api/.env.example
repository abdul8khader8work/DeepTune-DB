# DeepTune API — copy to apps/api/.env for local runs. Never commit a real .env.

APP_ENV=dev
APP_VERSION=0.2.0
CORS_ORIGINS=http://localhost:3000

# Auth: HS256 bearer tokens. Mint a dev token with `python -m src.cli.token`.
AUTH_ENABLED=true
JWT_SECRET=change-me-to-a-long-random-string
JWT_AUDIENCE=deeptune-web
JWT_TTL_MINUTES=720

# Encrypts target DSNs at rest. Any long random string works; a generated
# Fernet key (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# is recommended.
CREDENTIAL_ENCRYPTION_KEY=change-me-to-a-long-random-string

# App metadata DB (encrypted DSNs) and Shadow DB (hypopg validation).
METADATA_DB_DSN=postgresql://deeptune:change-me@localhost:5434/deeptune_meta
SHADOW_DB_DSN=postgresql://shadow_user:change-me@localhost:5433/shadow_db

# Safety limits.
TARGET_CONNECT_TIMEOUT_S=5
EXPLAIN_TIMEOUT_MS=5000
# The baseline is measured this many times and the median is kept.
EXPLAIN_MEASUREMENT_RUNS=5
MAX_SQL_LENGTH=10000
ANALYZE_RATE_LIMIT=10/minute
SHADOW_VALIDATE=true
RUN_TTL_SECONDS=1800

# Statistics maintenance (Patch 2 Task 2). When enabled the API opens an
# ephemeral owner connection, runs VACUUM (ANALYZE, SKIP_LOCKED), closes it, and
# only then touches the target with the read-only role. Leave the credential
# blank (and the flag true) to skip the refresh with a warning.
TARGET_ALLOW_MAINTENANCE=true
TARGET_SUPERUSER_DSN=
TARGET_SUPERUSER_PASSWORD=
TARGET_SUPERUSER_USER=postgres
MAINTENANCE_TIMEOUT_MS=10000

# Hypothetical plans for the beam (Patch 2 Task 3). The API injects the first
# HYPOPG_PREFETCH_LIMIT configurations through hypopg so the GNN scores post-index
# QEPs; 0 disables the prefetch and the beam falls back to the offline builder.
HYPOPG_PREFETCH_LIMIT=48
