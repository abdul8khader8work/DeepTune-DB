# ---------------------------------------------------------------------------
# DeepTune environment template. Copy to .env and fill in locally.
# NEVER commit a real .env file. See AGENTS.md for the security rules.
# ---------------------------------------------------------------------------

# Frontend -> FastAPI (Phase 2+)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# --- Docker Compose (dev-only defaults; change before sharing) -------------
TARGET_SUPERUSER_PASSWORD=postgres_dev_password
TARGET_DB_PASSWORD=query_optimizer_dev_password
SHADOW_DB_PASSWORD=shadow_dev_password
METADATA_DB_USER=deeptune
METADATA_DB_PASSWORD=deeptune_dev_password
METADATA_DB_NAME=deeptune_meta

# --- API security ----------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_AUDIENCE=deeptune-web
AUTH_ENABLED=true

# Encrypts target DSNs at rest. Generate a Fernet key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=replace-with-generated-fernet-key

# --- API data sources ------------------------------------------------------
# Used when running the API outside Docker (host ports from compose).
# The connect endpoint builds DSNs itself; TARGET_DB_DSN is only for psql.
TARGET_DB_DSN=postgresql://query_optimizer:query_optimizer_dev_password@localhost:5432/target_db
SHADOW_DB_DSN=postgresql://shadow_user:shadow_dev_password@localhost:5433/shadow_db
METADATA_DB_DSN=postgresql://deeptune:deeptune_dev_password@localhost:5434/deeptune_meta

# Safety limits.
TARGET_CONNECT_TIMEOUT_S=5
EXPLAIN_TIMEOUT_MS=5000
# Median-of-5 baseline: 5 EXPLAIN (ANALYZE) runs, fastest and slowest dropped.
EXPLAIN_MEASUREMENT_RUNS=5
MAX_SQL_LENGTH=10000
ANALYZE_RATE_LIMIT=10/minute
# VACUUM ANALYZE is attempted before the baseline. The read-only target role
# normally refuses (it needs table ownership); the API logs that and continues.
TARGET_ALLOW_MAINTENANCE=true
SHADOW_VALIDATE=true
RUN_TTL_SECONDS=1800

# --- Phase 4: neuro-symbolic engine ---------------------------------------
# ML_ENABLED=false forces the Phase 2 heuristic recommender (useful for demos
# and for hosts without torch). ML_ENGINE_SRC / ML_CHECKPOINT_PATH default to
# the repository layout; override them only for a non-standard install.
ML_ENABLED=true
ML_DEVICE=cpu
ML_ATTENTION_NODES=10
# The engine scores through onnxruntime when weights/demo-final.onnx exists;
# `make ml-export` produces it. Delete the file to fall back to the torch forward.
# Copilot typing illusion: ms per character, and the pause before each tool call.
COPILOT_STREAM_DELAY_MS=20
COPILOT_THINKING_DELAY_MS=500

# --- Phase 4: frontend -----------------------------------------------------
# Bearer token minted by `cd apps/api && .venv/Scripts/python -m src.cli.token`.
# Leave empty and paste it into localStorage["deeptune.token"] instead.
NEXT_PUBLIC_API_TOKEN=

# Demo connection prefilled by the web app (matches docker-compose).
NEXT_PUBLIC_DB_HOST=localhost
NEXT_PUBLIC_DB_PORT=5432
NEXT_PUBLIC_DB_NAME=target_db
NEXT_PUBLIC_DB_USER=query_optimizer
NEXT_PUBLIC_DB_PASSWORD=query_optimizer_dev_password
