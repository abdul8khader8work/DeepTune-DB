# ---------------------------------------------------------------------------
# DeepTune environment template. Copy to .env and fill in locally.
# NEVER commit a real .env file. See AGENTS.md for the security rules.
# ---------------------------------------------------------------------------

# Frontend -> FastAPI (Phase 2+)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Target PostgreSQL (Phase 2+) — read-only role only
TARGET_DB_DSN=postgresql://query_optimizer:change-me@localhost:5432/target_db

# Shadow PostgreSQL with hypopg (Phase 2+)
SHADOW_DB_DSN=postgresql://query_optimizer:change-me@localhost:5433/shadow_db

# Fernet key used to encrypt DSNs at rest (Phase 2+)
CREDENTIAL_ENCRYPTION_KEY=replace-with-generated-fernet-key
